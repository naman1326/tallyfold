# ==============================================================================
# Tallyfold Environment Configuration
# ==============================================================================

# Backend API Gateway target base URL (includes /prod stage)
API_BASE=https://vec4q0sqc9.execute-api.eu-north-1.amazonaws.com/prod

# Server-side secrets: used by the Vite dev gateway and the production proxy in /proxy.
# NEVER prefix with VITE_ to prevent bundling into client JavaScript.
API_KEY=
REVIEW_TOKEN=

# Client configuration (Safe to expose in browser)
# VITE_DEMO: Set to 'true' to use offline mock data, or 'false' to call real backend.
VITE_DEMO=false

# Optional client proxy URL override:
# When left unset or set to '/api', the app calls relative '/api/*', which works with:
# 1) The local Vite development proxy in vite.config.ts
# 2) AWS Amplify Hosting 200 Rewrite rules forwarding /api/<*> to the Lambda proxy
# VITE_API_BASE=/api
